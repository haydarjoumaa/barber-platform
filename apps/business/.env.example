# Copy to .env.local and use the same local PostgreSQL connection as the Client App.
DATABASE_URL=postgresql://barber:replace-with-local-password@localhost:5432/barber?schema=public
APP_ORIGIN=http://localhost:3001

# Optional: use the same absolute private upload path in both apps and operator scripts.
# BARBER_UPLOAD_ROOT=/absolute/path/to/barber-platform/.local/uploads
