generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StaffRole {
  OWNER
  BARBER
  RECEPTIONIST
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum MediaKind {
  SHOP_LOGO
  PROFILE
  HAIRCUT
}

model Barbershop {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  phone       String? @db.VarChar(16)
  address     String? @db.VarChar(500)
  description String? @db.VarChar(2000)
  brandColor  String @default("#2563eb") @map("brand_color") @db.VarChar(7)
  slug        String   @unique
  timeZone    String   @default("Asia/Beirut") @map("time_zone")
  currency    String?  @db.VarChar(3)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  suspendedAt DateTime? @map("suspended_at") @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships ShopMembership[]
  barbers     Barber[]
  clients     Client[]
  clientAccounts ClientAccount[]
  appointments Appointment[]
  services Service[]
  barberServices BarberService[]
  auditEvents AuditEvent[]
  closures ShopClosure[]
  bookingPolicy ShopBookingPolicy?
  clientEvents ClientEvent[]
  staffInvites StaffInvite[]
  mediaAssets MediaAsset[]

  @@unique([id, currency])

  @@map("barbershops")
}

// Staff identity is independent of shop membership and barber profile.
model User {
  id           String @id @default(uuid()) @db.Uuid
  email        String @unique
  passwordHash String? @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  memberships  ShopMembership[]
  auditEvents AuditEvent[]
  recordedPayments Payment[]
  platformAdmin PlatformAdmin?
  platformEvents PlatformAuditEvent[]
  mediaUploads MediaAsset[]

  @@map("users")
  sessions StaffSession[]
  authEvents StaffAuthEvent[]
}

model PlatformAdmin {
  userId String @id @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@map("platform_admins")
}

model PlatformAuditEvent {
  id String @id @default(uuid()) @db.Uuid
  actorUserId String @map("actor_user_id") @db.Uuid
  event String @db.VarChar(64)
  details Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actor User @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  @@index([createdAt])
  @@map("platform_audit_events")
}

model StaffSession {
  tokenHash String @id @map("token_hash") @db.VarChar(64)
  userId String @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
  @@map("staff_sessions")
}

model AuthRateLimit {
  key String @id @db.VarChar(100)
  attempts Int
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  @@index([expiresAt])
  @@map("auth_rate_limits")
}

// Global identity security events, not tenant-owned appointment/activity records.
model StaffAuthEvent {
  id String @id @default(uuid()) @db.Uuid
  userId String? @map("user_id") @db.Uuid
  event String @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([userId, createdAt])
  @@map("staff_auth_events")
}

model ShopMembership {
  id           String @id @default(uuid()) @db.Uuid
  barbershopId String @map("barbershop_id") @db.Uuid
  userId       String @map("user_id") @db.Uuid
  role         StaffRole
  manageAppointments Boolean @default(false) @map("manage_appointments")
  manageSchedules Boolean @default(false) @map("manage_schedules")
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Restrict)
  user         User @relation(fields: [userId], references: [id], onDelete: Restrict)
  barber       Barber?

  @@unique([barbershopId, userId])
  @@unique([barbershopId, id])
  @@map("shop_memberships")
}

model StaffInvite {
  id String @id @default(uuid()) @db.Uuid
  barbershopId String @map("barbershop_id") @db.Uuid
  tokenHash String @unique @map("token_hash") @db.VarChar(64)
  email String @db.VarChar(254)
  displayName String @map("display_name") @db.VarChar(100)
  role StaffRole
  manageAppointments Boolean @default(false) @map("manage_appointments")
  manageSchedules Boolean @default(false) @map("manage_schedules")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  shop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Restrict)
  @@unique([barbershopId, id])
  @@index([barbershopId, email])
  @@map("staff_invites")
}

model Barber {
  id           String @id @default(uuid()) @db.Uuid
  barbershopId String @map("barbershop_id") @db.Uuid
  membershipId String @map("membership_id") @db.Uuid
  displayName  String @map("display_name")
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Restrict)
  membership   ShopMembership @relation(fields: [barbershopId, membershipId], references: [barbershopId, id], onDelete: Restrict)
  appointments Appointment[]
  services BarberService[]
  schedulePeriods BarberSchedulePeriod[]
  timeOff BarberTimeOff[]
  scheduleOverrides BarberScheduleOverride[]

  @@unique([barbershopId, membershipId])
  @@unique([barbershopId, id])
  @@map("barbers")
}

// Staff-created client records need not have login credentials.
model Client {
  id           String @id @default(uuid()) @db.Uuid
  barbershopId String @map("barbershop_id") @db.Uuid
  name         String
  phone        String
  email        String?
  birthday     DateTime? @db.Date
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Restrict)
  account      ClientAccount?
  appointments Appointment[]
  sessions ClientSession[]
  resetTokens ClientResetToken[]
  events ClientEvent[]
  photos MediaAsset[]

  @@unique([barbershopId, phone])
  @@unique([barbershopId, id])
  @@map("clients")
}

model MediaAsset {
  id String @id @default(uuid()) @db.Uuid
  barbershopId String @map("barbershop_id") @db.Uuid
  clientId String? @map("client_id") @db.Uuid
  uploadedByUserId String? @map("uploaded_by_user_id") @db.Uuid
  kind MediaKind
  storageKey String @unique @map("storage_key") @db.VarChar(40)
  mimeType String @map("mime_type") @db.VarChar(32)
  byteSize Int @map("byte_size")
  width Int
  height Int
  consentAt DateTime @map("consent_at") @db.Timestamptz(3)
  consentSource String @map("consent_source") @db.VarChar(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  removedAt DateTime? @map("removed_at") @db.Timestamptz(3)
  purgedAt DateTime? @map("purged_at") @db.Timestamptz(3)
  shop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Restrict)
  client Client? @relation(fields: [barbershopId, clientId], references: [barbershopId, id], onDelete: Restrict)
  uploader User? @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  @@unique([barbershopId, id])
  @@index([barbershopId, clientId, createdAt])
  @@map("media_assets")
}

// Phone is held on Client to avoid diverging account/profile phone values.
model ClientAccount {
  id           String @id @default(uuid()) @db.Uuid
  barbershopId String @map("barbershop_id") @db.Uuid
  clientId     String @map("client_id") @db.Uuid
  passwordHash String @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Restrict)
  client       Client @relation(fields: [barbershopId, clientId], references: [barbershopId, id], onDelete: Restrict)

  @@unique([barbershopId, clientId])
  @@map("client_accounts")
}

model ClientSession {
  tokenHash String @id @map("token_hash") @db.VarChar(64)
  barbershopId String @map("barbershop_id") @db.Uuid
  clientId String @map("client_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  client Client @relation(fields: [barbershopId, clientId], references: [barbershopId, id], onDelete: Cascade)
  @@index([barbershopId, clientId])
  @@index([expiresAt])
  @@map("client_sessions")
}

model ClientResetToken {
  tokenHash String @id @map("token_hash") @db.VarChar(64)
  barbershopId String @map("barbershop_id") @db.Uuid
  clientId String @map("client_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  client Client @relation(fields: [barbershopId, clientId], references: [barbershopId, id], onDelete: Cascade)
  @@unique([barbershopId, clientId])
  @@map("client_reset_tokens")
}

model ClientEvent {
  id String @id @default(uuid()) @db.Uuid
  barbershopId String @map("barbershop_id") @db.Uuid
  clientId String? @map("client_id") @db.Uuid
  event String @db.VarChar(64)
  details Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  shop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Restrict)
  client Client? @relation(fields: [barbershopId, clientId], references: [barbershopId, id], onDelete: Restrict)
  @@index([barbershopId, createdAt])
  @@map("client_events")
}

// Reservation foundation with service snapshots. Booking workflows follow.
// The SQL migration owns the interval checks and GiST exclusion constraint;
// Prisma schema generation alone does not install those protections.
model Appointment {
  id            String @id @default(uuid()) @db.Uuid
  barbershopId  String @map("barbershop_id") @db.Uuid
  barberId      String @map("barber_id") @db.Uuid
  clientId      String? @map("client_id") @db.Uuid
  guestName     String? @map("guest_name") @db.VarChar(100)
  guestPhone    String? @map("guest_phone") @db.VarChar(16)
  status        AppointmentStatus
  startsAt      DateTime @map("starts_at") @db.Timestamptz(3)
  serviceEndsAt DateTime @map("service_ends_at") @db.Timestamptz(3)
  occupiedUntil DateTime @map("occupied_until") @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  barbershop    Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Restrict)
  barber        Barber @relation(fields: [barbershopId, barberId], references: [barbershopId, id], onDelete: Restrict)
  client        Client? @relation(fields: [barbershopId, clientId], references: [barbershopId, id], onDelete: Restrict)
  services      AppointmentService[]
  payments      Payment[]

  @@unique([barbershopId, id])
  @@index([barbershopId, startsAt])
  @@index([barbershopId, clientId, startsAt])
  @@map("appointments")
}

// In-shop receipts only. The migration enforces one non-voided receipt per appointment.
model Payment {
  id String @id @default(uuid()) @db.Uuid
  barbershopId String @map("barbershop_id") @db.Uuid
  appointmentId String @map("appointment_id") @db.Uuid
  recordedBy String @map("recorded_by") @db.Uuid
  amountMinor BigInt @map("amount_minor")
  currency String @db.VarChar(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  voidedAt DateTime? @map("voided_at") @db.Timestamptz(3)
  voidReason String? @map("void_reason") @db.VarChar(500)
  appointment Appointment @relation(fields: [barbershopId, appointmentId], references: [barbershopId, id], onDelete: Restrict, onUpdate: Restrict)
  recorder User @relation(fields: [recordedBy], references: [id], onDelete: Restrict)
  @@unique([barbershopId, id])
  @@index([barbershopId, createdAt])
  @@map("payments")
}

model Service {
  id              String @id @default(uuid()) @db.Uuid
  barbershopId    String @map("barbershop_id") @db.Uuid
  name            String @db.VarChar(100)
  durationMinutes Int @map("duration_minutes")
  priceMinor      Int @map("price_minor")
  currency        String @db.VarChar(3)
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  barbershop      Barbershop @relation(fields: [barbershopId, currency], references: [id, currency], onDelete: Restrict, onUpdate: Restrict)
  barbers         BarberService[]
  appointmentServices AppointmentService[]

  @@unique([barbershopId, id])
  @@map("services")
}

// A row explicitly enables this service for the barber; null overrides inherit shop values.
model BarberService {
  barbershopId    String @map("barbershop_id") @db.Uuid
  barberId        String @map("barber_id") @db.Uuid
  serviceId       String @map("service_id") @db.Uuid
  durationMinutes Int? @map("duration_minutes")
  priceMinor      Int? @map("price_minor")
  barbershop      Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Restrict)
  barber          Barber @relation(fields: [barbershopId, barberId], references: [barbershopId, id], onDelete: Restrict)
  service         Service @relation(fields: [barbershopId, serviceId], references: [barbershopId, id], onDelete: Restrict)

  @@id([barbershopId, barberId, serviceId])
  @@index([barbershopId, serviceId])
  @@map("barber_services")
}

// Copied at booking time, never joined to live catalog values for history/totals.
// Tenant-safe source links retain provenance; catalog edits do not update snapshots.
model AppointmentService {
  id String @id @default(uuid()) @db.Uuid
  barbershopId String @map("barbershop_id") @db.Uuid
  appointmentId String @map("appointment_id") @db.Uuid
  serviceId String @map("service_id") @db.Uuid
  position Int
  name String @db.VarChar(100)
  durationMinutes Int @map("duration_minutes")
  priceMinor Int @map("price_minor")
  currency String @db.VarChar(3)
  appointment Appointment @relation(fields: [barbershopId, appointmentId], references: [barbershopId, id], onDelete: Restrict, onUpdate: Restrict)
  service Service @relation(fields: [barbershopId, serviceId], references: [barbershopId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([barbershopId, appointmentId, position])
  @@unique([barbershopId, appointmentId, serviceId])
  @@index([barbershopId, serviceId])
  @@map("appointment_services")
}

model AuditEvent {
  id           String @id @default(uuid()) @db.Uuid
  barbershopId String @map("barbershop_id") @db.Uuid
  actorUserId  String @map("actor_user_id") @db.Uuid
  event        String @db.VarChar(64)
  details      Json
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Restrict)
  actor        User @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([barbershopId, createdAt])
  @@map("audit_events")
}

model BarberSchedulePeriod {
  id String @id @default(uuid()) @db.Uuid
  barbershopId String @map("barbershop_id") @db.Uuid
  barberId String @map("barber_id") @db.Uuid
  dayOfWeek Int @map("day_of_week")
  kind String @db.VarChar(5)
  startMinute Int @map("start_minute")
  endMinute Int @map("end_minute")
  startOccurrence String? @map("start_occurrence") @db.VarChar(7)
  endOccurrence String? @map("end_occurrence") @db.VarChar(7)
  barber Barber @relation(fields: [barbershopId, barberId], references: [barbershopId, id], onDelete: Restrict)
  @@unique([barbershopId, id])
  @@index([barbershopId, barberId, dayOfWeek])
  @@map("barber_schedule_periods")
}

model BarberTimeOff {
  id String @id @default(uuid()) @db.Uuid
  barbershopId String @map("barbershop_id") @db.Uuid
  barberId String @map("barber_id") @db.Uuid
  startsAt DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt DateTime @map("ends_at") @db.Timestamptz(3)
  barber Barber @relation(fields: [barbershopId, barberId], references: [barbershopId, id], onDelete: Restrict)
  @@unique([barbershopId, id])
  @@index([barbershopId, barberId, startsAt])
  @@map("barber_time_off")
}

model BarberScheduleOverride {
  id String @id @default(uuid()) @db.Uuid
  barbershopId String @map("barbershop_id") @db.Uuid
  barberId String @map("barber_id") @db.Uuid
  date DateTime @db.Date
  periods Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  barber Barber @relation(fields: [barbershopId, barberId], references: [barbershopId, id], onDelete: Restrict)
  @@unique([barbershopId, barberId, date])
  @@unique([barbershopId, id])
  @@map("barber_schedule_overrides")
}

model ShopClosure {
  id String @id @default(uuid()) @db.Uuid
  barbershopId String @map("barbershop_id") @db.Uuid
  date DateTime @db.Date
  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Restrict)
  @@unique([barbershopId, date])
  @@unique([barbershopId, id])
  @@map("shop_closures")
}

model ShopBookingPolicy {
  barbershopId String @id @map("barbershop_id") @db.Uuid
  slotIntervalMinutes Int @map("slot_interval_minutes")
  minimumNoticeMinutes Int @map("minimum_notice_minutes")
  bufferAfterMinutes Int @map("buffer_after_minutes")
  cancellationNoticeMinutes Int @map("cancellation_notice_minutes")
  reschedulingNoticeMinutes Int @map("rescheduling_notice_minutes")
  approvalMode String @map("approval_mode") @db.VarChar(9)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Restrict)
  @@map("shop_booking_policies")
}
